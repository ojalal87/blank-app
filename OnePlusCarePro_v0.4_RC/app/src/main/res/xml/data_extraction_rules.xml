<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Safe Trash files/journal reference device-local paths and must never be restored elsewhere. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="care_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="care_settings.xml" />
    </device-transfer>
</data-extraction-rules>
