<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext anywhere; trust only system CAs (user-installed CAs cannot intercept the app's probes). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
